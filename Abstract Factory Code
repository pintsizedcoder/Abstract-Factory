from abc import ABC, abstractmethod


# 1. Abstract products

class Chair(ABC):
# Abstract product interface for chair

    @abstractmethod
    def sit_on(self):
        pass

    @abstractmethod
    def get_description(self):
        pass


class Table(ABC):
# Abstract product interface for table

    @abstractmethod
    def place_items(self):
        pass

    @abstractmethod
    def get_description(self):
        pass


class Sofa(ABC):
# Abstract product interface for sofa

    @abstractmethod
    def relax_on(self):
        pass

    @abstractmethod
    def get_description(self):
        pass


# 2. Concrete products

class ModernChair(Chair):
    def __init__(self):
        self.style = "Modern"
        self.material = "Steel and Leather"
        self.price = 299.99

    def sit_on(self):
        print(f"Sitting on a {self.style} chair made of {self.material}")

    def get_description(self):
        return f"{self.style} chair made of {self.material} - ${self.price}"


